# Copy to fastlane/.env. Use absolute paths; do not paste private keys here.
# Team key with App Manager access, created in App Store Connect > Users and Access > Integrations.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_FILEPATH=

# Service-account JSON authorized for this app in Play Console > Users and permissions.
GOOGLE_PLAY_JSON_KEY=

# Optional: absolute Flutter executable (defaults to flutter on PATH).
# FLUTTER_BIN=/absolute/path/to/flutter/bin/flutter

# Optional: existing Xcode export options, for custom/manual signing.
# IOS_EXPORT_OPTIONS_PLIST=/absolute/path/to/ExportOptions.plist

FASTLANE_OPT_OUT_USAGE=1
FASTLANE_SKIP_UPDATE_CHECK=1
