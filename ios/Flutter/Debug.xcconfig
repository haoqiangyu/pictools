#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// iPhone Duo reserved regions are available when building with the verified 27.1 SDK API surface.
SWIFT_ACTIVE_COMPILATION_CONDITIONS[sdk=iphoneos27.1*] = $(inherited) PICTOOLS_DUO_SDK
SWIFT_ACTIVE_COMPILATION_CONDITIONS[sdk=iphonesimulator27.1*] = $(inherited) PICTOOLS_DUO_SDK
